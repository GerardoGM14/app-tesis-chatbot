# Plantilla de /opt/plataforma/staging.env y /opt/plataforma/production.env (permisos 600).
# Cada entorno usa valores distintos. Genera los secretos con:  openssl rand -hex 32

GHCR_OWNER=tu-usuario-de-github-en-minusculas

POSTGRES_DB=plataforma
POSTGRES_USER=plataforma_owner
POSTGRES_PASSWORD=
APP_DB_PASSWORD=
JWT_SECRET=
INTERNAL_HMAC_SECRET=

# Solo para el primer despliegue: crea el superadmin si no existe. Luego puedes borrarlas.
SUPERADMIN_EMAIL=
SUPERADMIN_PASSWORD=
