# Copia este archivo como .env para el entorno local (docker compose).
# Usa valores alfanuméricos largos: van dentro de URLs de conexión.
# Para generar uno:  openssl rand -hex 24

POSTGRES_DB=plataforma
POSTGRES_USER=plataforma_owner
POSTGRES_PASSWORD=cambia-esto-owner-local

# Contraseña del rol con el que se conecta el backend (sin BYPASSRLS).
APP_DB_PASSWORD=cambia-esto-app-local-123

# Mínimo 32 caracteres.
JWT_SECRET=cambia-esto-por-un-secreto-de-32-o-mas

# Firma de las llamadas internas backend <-> wa-service. Mínimo 32 caracteres.
INTERNAL_HMAC_SECRET=cambia-esto-por-otro-secreto-de-32-o-mas

# Superadministrador inicial. Se le pedirá cambiar la contraseña al ingresar.
SUPERADMIN_EMAIL=superadmin@sertech.local
SUPERADMIN_PASSWORD=Inicial-Plataforma-2026
